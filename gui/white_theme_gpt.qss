/* /////////////////////////////////////////////////////////////////////////
   LIGHT THEME - Converted from your Dark Theme
///////////////////////////////////////////////////////////////////////// */

* {
    font: 13pt "Lucida Casual";
}

QWidget {
    color: #222;
    background-color: #f7f7f7;
}

/* ==================
   QMenu
================== */
QMenu {
    font: 12pt "Lucida Casual";
    background: #ffffff;
    border-radius: 4px;
    border: 1px solid #cfcfcf;
    padding: 10px;
    color: #444;
}

QMenu::separator {
    height: 1px;
    background: #e5e5e5;
    margin: 4px;
}

QMenu::item {
    color: #444;
    border-radius: 2px;
    font-size: 14px;
    padding: 6px 8px;
    min-width: 120px;
    max-width: 240px;
}

QMenu::item:selected {
    background-color: #e9e9e9;
    color: #000;
}

QMenu::item:disabled {
    color: #9e9e9e;
}

/* ==================
   Tooltip
================== */
QToolTip {
    color: #000;
    background-color: #ffffe0;
    border: 1px solid #bfbfbf;
    padding: 3px;
    font: 9pt "Lucida Casual";
    border-radius: 5px;
}

/* ==================
   QGroupBox
================== */
QGroupBox {
    background-color: #ffffff;
    border: 2px solid #dcdcdc;
    border-radius: 5px;
    margin-top: 1ex;
}

QGroupBox::title {
    padding: 0 3px;
    margin-left: 10px;
    background-color: transparent;
}

/* ==================
   QPushButton
================== */
QPushButton {
    font: 13pt "Lucida Casual";
    border-radius: 5px;
    background-color: #efefef;
    border: 1px solid #d0d0d0;
    min-height: 50px;
    padding: 3px 15px;
}

QPushButton:hover {
    background-color: #e4e4e4;
}

QPushButton:pressed {
    background-color: #ffffff;
    border: 2px solid #b0b0b0;
}

QPushButton:!enabled {
    color: #c1c1c1;
    background-color: #f5f5f5;
}

/* ==================
   QTableWidget
================== */
QTableWidget {
    background-color: #ffffff;
    padding: 5px 0px;
    border-radius: 5px;
    gridline-color: #dcdcdc;
    border-bottom: 1px solid #cfcfcf;
}

QTableWidget::item {
    border-color: #dcdcdc;
    padding-left: 5px;
    padding-right: 5px;
}

QTableWidget::item:selected {
    background-color: #dfe9ff;
}

QHeaderView::section {
    background-color: #f0f0f0;
    border: 1px solid #dcdcdc;
}

/* ==================
   QLineEdit, SpinBoxes
================== */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit {
    background-color: #ffffff;
    border: 2px solid #d0d0d0;
    border-radius: 5px;
    padding-left: 10px;
    min-height: 50px;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border: 2px solid #a0c4ff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 2px solid #388bfd;
}

/* ==================
   QPlainTextEdit
================== */
QPlainTextEdit {
    background-color: #ffffff;
    border-radius: 5px;
    padding: 10px;
    selection-color: #ffffff;
    selection-background-color: #5599ff;
    border: 1px solid #dfdfdf;
}

/* ==================
   QScrollBar
================== */
QScrollBar:horizontal {
    background: #efefef;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #bfbfbf;
    border-radius: 4px;
}

QScrollBar:vertical {
    background: #efefef;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #bfbfbf;
    border-radius: 4px;
}

/* ==================
   QCheckBox & QRadioButton
================== */
QCheckBox::indicator,
QRadioButton::indicator {
    border: 2px solid #bdbdbd;
    background: #ffffff;
    width: 15px;
    height: 15px;
    border-radius: 10px;
}

QCheckBox::indicator:checked {
    background-image: url(:/icons/images/icons/cil-check-alt.png);
    background-repeat: no-repeat;
    background-position: center;
}

/* ==================
   QComboBox
================== */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #d0d0d0;
    padding-left: 10px;
    min-height: 50px;
}

QComboBox:hover {
    border: 2px solid #b0b0b0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #444;
    border: 1px solid #d0d0d0;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #dfe9ff;
}

/* ==================
   QSlider
================== */
QSlider::groove:horizontal,
QSlider::groove:vertical {
    background-color: #dedede;
    border-radius: 5px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: #4b90ff;
    border-radius: 5px;
}

/* ==================
   QCommandLinkButton
================== */
QCommandLinkButton {
    color: #0066cc;
}

QCommandLinkButton:hover {
    background-color: #e9e9e9;
}

/* ==================
   QTabWidget (Light)
================== */
QTabWidget::pane {
    border: 2px solid #cccccc;
    background: #ffffff;
}

QTabBar::tab {
    background: #f0f0f0;
    color: #333;
    padding: 8px 18px;
    border: 1px solid #d0d0d0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:hover {
    background: #e8e8e8;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #000;
    border-bottom: none;
}

/* ==================
   Background Sections
================== */

#centralWidget,
#contentWidget,
#widgetMainContent,
#EmployesPage,
#ClientsPage,
#CreditPage,
#VersementPage,
#EmployeOperationsPage,
#ChargePage,
#PaymentsWidgetContainer,
#EtatPage,
#tabeDetailsJournee,
#tabSumByDays,
#tabEtatByDriver {
    background-color: #ffffff;
}

#leftMenuBg {
    background-color: #f3f3f3;
}

#contentTopBg {
    background-color: #f3f3f3;
}
