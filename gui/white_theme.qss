/* =============
	== LINES
   ============= */
#line, #line_2, #line_3, #line_4, #line_5, #line_6, #line_7, #line_8 {
	background-color: #D9D9D9;
}

/* ==================
   == ExtraLeftBox
   ================== */
#extraLeftBox {
	background-color: #272727;
	border: 2px solid #202020;
	border-left-color: #2C3E50;
}
#AddCreditPage,
#AddCreditVersementPage,
#AddPersonePage,
#VersementPage,
#AddEmpOperationPage,
#salairePage,
#addChargePage
{	
	background-color: #272727;
}
#extraTopBg{	
	background-color: #202020;
}

/* == Icon == */
#extraIcon {
	background-position: center;
	background-repeat: no-repeat;
	background-image: url(:/icons/images/icons/cil-plus.png);
}

/* Label */
#extraLabelTitle { color: #00AFF0; }

#widgetSalairePage QLabel {
	padding: 5px;
	font: 75 14pt "Lucida Casual";
	border: 1px solid rgb(44, 49, 60);
	border-top: none;
	border-left: none;
	border-right: none;
}

/* == Extra Content == */
#extraContent{
	/*border-top: 3px solid #2a2a2a;*/
		border-top-left-radius: 15px;
}

/* == Extra Top Menus == */
#extraTopMenu .QPushButton {
background-position: left center;
    background-repeat: no-repeat;
	border: none;
	border-left: 22px solid transparent;
	background-color:transparent;
	text-align: left;
	padding-left: 44px;
}
#extraTopMenu .QPushButton:hover {
	background-color: rgb(40, 44, 52);
}
#extraTopMenu .QPushButton:pressed {	
	background-color: rgb(189, 147, 249);
	color: rgb(255, 255, 255);
}

/* =================
   == UPBAR
   ================= */
#contentTopBg{	
	background-color: #F3F3F3;
}

/* ==================
   == Frame Messages
   ================== */
#frameMsgs {
	background-color: rgba(60, 184, 127, 47);
	border-radius: 5px;
}

#labelMsgs {
	color: #44e37b;
	padding: 5px 7px;
	border-top-left-radius: 5px;
	border-bottom-left-radius: 5px;
}

#frameMsgs QPushButton {
	background: transparent;
	border: none;
	border-radius: 0;
	border-top-right-radius: 5px;	
	border-bottom-right-radius: 5px;
}
#frameMsgs QPushButton:hover {
	border: none;
}