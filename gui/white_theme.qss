/*------------------------------------------------------*/
/*

TopMenu: #F3F3F3;
GreenColor: #114b35;
ContentColor: #FEFEFE;
HoverColor: #383838;

BorderColor:#D9D9D9;
*/

* {	
	font: 13pt "Lucida Casual";
}

QWidget{
	color: #1B1B1B;
}


/* ==================
	== Tooltip
   ================== */
QToolTip {
	color: #ffffff;
	background-color: #202020;
	border: 1px solid #696969;
	text-align: left;
	margin: 0px;
	padding: 3px;	
	font: 9pt "Lucida Casual";
	border-radius: 5px;
}

/* ==================
	== QGroupBox
   ================== */
QGroupBox {
    background-color: #FEFEFE;
    border: 1px solid #D9D9D9;
    border-radius: 5px;
    margin-top: 1ex; /* leave space at the top for the title */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* position at the top center */
    padding: 0 3px;
	margin-left: 10px;
    background-color: transparent;
}
/* ==================
	== QPushButtons
   ================== */
QPushButton {
	font: 13pt "Lucida Casual";	
	background-color: #FEFEFE;
	border: 1px solid #D9D9D9;
	border-radius: 5px;
	min-height: 41px;	
	padding: 3px 15px;
}
/* == Hover == */
QPushButton:hover {
	background-color: #EFEFEF;
}
/* == Pressed == */
QPushButton:pressed {	
	background-color: transparent;
	border: 2px solid #D9D9D9;
}
/* == !Enabled == */
QPushButton:!enabled {
	color: #73797b;
	background-color: #DADADA;
}

/* == Remove Menu Indicator from Button with Menu == */
QPushButton::menu-indicator {
	image: none;
}

/* === Buttons Just Icons == */
#buttonRefreshClientsTable,
#buttonDeleteClient,

#buttonRefreshEmpolyeTable,
#buttonDeleteEmploye,

#buttonRefreshEmpolyeOperationTable,
#buttonDeleteEmployeOperation,

#buttonRefreshCreditTable,
#buttonRefreshChargeTable,

#buttonDeleteCredit,
#buttonDeleteVersement {
	min-width: 50;
	min-height: 50;
	padding: 0;
}

#frameSum QPushButton, 
#frameSum_2 QPushButton, 
#frameSum_3 QPushButton {
	min-height: 80px;
	min-width: 66px;
	max-height: 80px;
	max-width: 66px;
	border-radius: 40px;
	background-color: #25d366;
}

/*
  == Close/Maximaze/Minimize QPushButtons ==
  == Btn Close ExtraLeftContent ==
*/
#extraIconPlus {
	background-color: transparent; 
	border: none;  
	border-radius: 5px; 
	min-height: 30px;
	min-width: 30px;
	padding: 0;
}

#rightButtons QPushButton,
#extraCloseColumnBtn
 { 
	background-color: transparent; 
	border: none;  
	border-radius: 5px; 
	min-height: 30px;
	min-width: 40px;
	padding: 0;
}

/* == Hover == */
#rightButtons QPushButton:hover,
#extraCloseColumnBtn:hover  { 
	background-color: #3d3d3d; 
	border-style: solid; 
	border-radius: 4px;
}

/* == Pressed == */
#rightButtons QPushButton:pressed,
#extraCloseColumnBtn:pressed { 
	background-color: rgb(23, 26, 30); 
	border-style: solid; 
	border-radius: 4px; 
}

#rightButtons #closeAppBtn:hover,
#extraCloseColumnBtn:hover {
	background-color: rgb(237, 51, 59);
}

/* == LEFT MENU Buttons == */
#topMenu .QPushButton {	
	font: 13pt "Lucida Casual";
	border-radius: 7px;
	background-color: transparent;
	min-height: 45px;
}

/* == Hover == */
#topMenu .QPushButton:hover {
	background-color: #E5E9E7;
}

/* == Pressed == */
#topMenu .QPushButton:pressed {	
	background-color: transparent;
	color: rgb(255, 255, 255);
}

/* == Checked == */
#topMenu .QPushButton:checked {
	/*background-color: rgb(40, 44, 52);*/	
	background-color: #EBEBEB;
	/* color: rgb(255, 255, 255); */
}

/* == Toggle Button == */
#toggleMenuButton {
	border: none;
	border-radius: 7px;
	background-color: rgb(37, 41, 48);
	color: rgb(113, 126, 149);
}
#toggleMenuButton:hover {
	background-color: rgb(40, 44, 52);
}
#toggleMenuButton:pressed {
	background-color: rgb(189, 147, 249);
}

/* ==================
	== QTableWidget
   ================== */
QTableWidget {	
	background-color: transparent;
	padding: 5px 0px;
	border-radius: 5px;
	gridline-color: #D9D9D9;
	border-bottom: 1px solid rgb(44, 49, 60);	
}
QTableWidget::item{
	border-color: #303030;
	padding-left: 5px;
	padding-right: 5px;
	gridline-color: rgb(44, 49, 60);
}
QTableWidget::item:selected{
	background-color: #F3F3F3;
	color: #000000;
}
QHeaderView::section{
	background-color: #F3F3F3;
	max-width: 30px;
	border: 1px solid #D9D9D9;
	border-style: none;
    border-bottom: 1px solid rgb(44, 49, 60);
    border-right: 1px solid #303030;
}
QTableWidget::horizontalHeader {	
	background-color: #F3F3F3;
}
QHeaderView::section:horizontal
{
    border: 1px solid #303030;
	padding: 3px;
}

/* ==================================================
	== QLineEdit, QSpinBox, QDoubleSpinbox, QDateEdit
   ================================================== */
QLineEdit, 
QSpinBox, 
QDoubleSpinBox, 
QDateEdit
{
	background-color: #FEFEFE;
	border: 1px solid #EAEAEA;
	border-radius: 5px;
	padding: 2px;
	padding-left: 10px;
	selection-color: rgb(255, 255, 255);
	selection-background-color: #3d3d3d;
	min-height: 50px;
}

QLineEdit {
	min-width: 350px;
}

/* == Hover == */
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
	border: 2px solid #D9D9D9;
}

/* == Focus == */
QLineEdit:focus,
QSpinbox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
	border: 2px solid #D9D9D9;
}

/* == !Enabled == */
QLineEdit:!enabled,
QSpinBox:!enabled,
QDoubleSpinBox:!enabled,
QDateEdit:!enabled {
	background-color: #202020;
}

/* editSearchCharge inside QGroupBox */
#editSearchCharge {
	border: 1px solid #303030;
}

#editSearchCharge:hover {
	border: 2px solid #303030;
}

#editSearchCharge:focus {
	border: 2px solid #303030;
}

/* ============================
   == QPlainText ==
   ============================ */
QPlainTextEdit {
	background-color: #F3F3F3;
	border-radius: 5px;
	padding: 10px;
	selection-color: rgb(255, 255, 255);
	selection-background-color: rgb(255, 121, 198);
}
QPlainTextEdit  QScrollBar:vertical {
    width: 8px;
 }
QPlainTextEdit  QScrollBar:horizontal {
    height: 8px;
 }
QPlainTextEdit:hover {
	border: 2px solid #D9D9D9;
}
QPlainTextEdit:focus {
	border: 2px solid #D9D9D9;
}

/* ============================
   == QScrollBar ==
   ============================ */
QScrollBar:horizontal {
    border: none;
    background: rgb(52, 59, 72);
    height: 8px;
    margin: 0px 21px 0 21px;
	border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #1dd1a1;
    min-width: 25px;
	border-radius: 4px
}
QScrollBar::add-line:horizontal {
    border: none;
    background: rgb(55, 63, 77);
    width: 20px;
	border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: rgb(55, 63, 77);
    width: 20px;
	border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal
{
     background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
     background: none;
}
 QScrollBar:vertical {
	border: none;
    background: rgb(52, 59, 72);
    width: 8px;
    margin: 21px 0 21px 0;
	border-radius: 0px;
 }
 QScrollBar::handle:vertical {	
	background: #1dd1a1;
    min-height: 25px;
	border-radius: 4px
 }
 QScrollBar::add-line:vertical {
     border: none;
    background: rgb(55, 63, 77);
     height: 20px;
	border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }
 QScrollBar::sub-line:vertical {
	border: none;
    background: rgb(55, 63, 77);
     height: 20px;
	border-top-left-radius: 4px;
    border-top-right-radius: 4px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     background: none;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }

/* ============================
   == QCheckBox ==
   ============================ */
QCheckBox::indicator {
    border: 3px solid rgb(52, 59, 72);
	width: 15px;
	height: 15px;
	border-radius: 10px;
    background: rgb(44, 49, 60);
}
QCheckBox::indicator:hover {
    border: 3px solid rgb(58, 66, 81);
}
QCheckBox::indicator:checked {
    background: 3px solid rgb(52, 59, 72);
	border: 3px solid rgb(52, 59, 72);	
	background-image: url(:/icons/images/icons/cil-check-alt.png);
}

/* ============================
   == QRadioButtons ==
   ============================ */
QRadioButton::indicator {
    border: 3px solid rgb(52, 59, 72);
	width: 15px;
	height: 15px;
	border-radius: 10px;
    background: rgb(44, 49, 60);
}
QRadioButton::indicator:hover {
    border: 3px solid rgb(58, 66, 81);
}
QRadioButton::indicator:checked {
    background: 3px solid rgb(94, 106, 130);
	border: 3px solid rgb(52, 59, 72);	
}

/* ============================
   == QComboBox ==
   ============================ */
QComboBox {
    background-color: #F3F3F3;
	border-radius: 5px;
	border: 2px solid #D9D9D9;
	padding: 0px 5px;
	padding-left: 10px;
	min-height: 40px;
}
QComboBox:hover{
	border: 2px solid #D9D9D9;
}
QComboBox::drop-down {
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 25px; 
	border-left-width: 3px;
	border-left-color: #D9D9D9;
	border-left-style: solid;
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;	
	background-image: url(:/icons/images/icons/cil-arrow-bottom.png);
	background-position: center;
	background-repeat: no-reperat;    
 }
QComboBox QAbstractItemView {
	color: #1dd1a1;	
	background-color: #18191c;
	border: 1px solid hsla(0, 0%, 100%, 0.3);
	padding: 8px 10px;
	selection-background-color: #3d3d3d;

}
QComboBox QAbstractItemView::item {
	padding: 8px 10px;
}
/* ============================
   == QSlider ==
   ============================ */
QSlider::groove:horizontal {
    border-radius: 5px;
    height: 10px;
	margin: 0px;
	background-color: rgb(52, 59, 72);
}
QSlider::groove:horizontal:hover {
	background-color: rgb(55, 62, 76);
}
QSlider::handle:horizontal {
    background-color: rgb(189, 147, 249);
    border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:horizontal:hover {
    background-color: rgb(195, 155, 255);
}
QSlider::handle:horizontal:pressed {
    background-color: rgb(255, 121, 198);
}

QSlider::groove:vertical {
    border-radius: 5px;
    width: 10px;
    margin: 0px;
	background-color: rgb(52, 59, 72);
}
QSlider::groove:vertical:hover {
	background-color: rgb(55, 62, 76);
}
QSlider::handle:vertical {
    background-color: rgb(189, 147, 249);
	border: none;
    height: 10px;
    width: 10px;
    margin: 0px;
	border-radius: 5px;
}
QSlider::handle:vertical:hover {
    background-color: rgb(195, 155, 255);
}
QSlider::handle:vertical:pressed {
    background-color: rgb(255, 121, 198);
}

/* ============================
   == QCommandLinkButton ==
   ============================ */
QCommandLinkButton {	
	color: rgb(255, 121, 198);
	border-radius: 5px;
	padding: 5px;
	color: rgb(255, 170, 255);
}
QCommandLinkButton:hover {	
	color: rgb(255, 170, 255);
	background-color: rgb(44, 49, 60);
}
QCommandLinkButton:pressed {	
	color: rgb(189, 147, 249);
	background-color: rgb(52, 58, 71);
}

