}

#contentWidget {
	background-color: #202020;
	border: 1px solid rgb(44, 49, 58);
}

#widgetMainContent {
	background-color: #252525;
	border-top-left-radius:  15px;
}

#EmployesPage,
#ClientsPage,
#CreditPage,
#VersementPage,
#EmployeOperationsPage,
#ChargePage,
#PaymentsWidgetContainer,
#EtatPage

{
