	border-radius: 5px;
}

/* === QPushButton EXCEL ETAT === */

#frameExcelEtatButtons .QPushButton,
#frameDBEtatButtons .QPushButton
{
	font: 12pt "Lucida Casual";
	background: #f17256;
	color: #fbfbfb;
	border-radius: 5px;
    padding: 0;

	max-height: 50px;
	min-height: 50px;
}

/*# TODO: change the name from label to btn because type (QPushButton)*/
#frameExcelEtatButtons #btnEtatSumExcelVersement,
#frameDBEtatButtons #labelEtatSumVerse {
