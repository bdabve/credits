	color: #21c063;
	font: italic 15pt "Lucida Casual";
}

#labelTitleSumAvance,
#labelTitleSumRetenu,
#labelTitleSumPrime {
	color: #929393;
	font: 9pt "Lucida Sans";
}


/* Label */
#labelDate,
#labelHijri {
	/* font: 14pt "Noto Sans Arabic";*/
    padding: 0 15px;
}

#extraLabelTitle { color: #1B8755; }

#widgetSalairePage QLabel {
	padding: 5px;
	font: 75 14pt "Lucida Casual";
	/*border: 1px solid rgb(44, 49, 60);*/
